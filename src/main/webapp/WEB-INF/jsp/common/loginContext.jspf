<%
Object nwLoginContext = session.getAttribute("loginContext");
if (nwLoginContext != null) {
%>
<script>
    window.NW_SERVER_LOGIN_CONTEXT = "<%= nwLoginContext %>";
    window.NW_CONTEXT_PATH = "<%= request.getContextPath() %>";
</script>
<script src="<%= request.getContextPath() %>/js/login-context.js?v=20260923-1"></script>
<%
}
%>
