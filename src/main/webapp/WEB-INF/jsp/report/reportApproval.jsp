<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>報告書承認</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/report.css"></head><body><jsp:include page="/WEB-INF/jsp/common/header.jsp"/>
<main class="report-page"><div class="report-heading"><div><p class="eyebrow">APPROVAL</p><h1>報告書承認</h1><p>提出された報告書を確認し、承認または差戻しを行います。</p></div></div><c:if test="${not empty flashMessage}"><div class="notice ${flashType}"><c:out value="${flashMessage}"/></div></c:if>
<div class="report-layout"><section class="report-list"><div class="list-title"><h2>報告書一覧</h2></div><c:forEach var="report" items="${reports}"><a class="report-list-item" href="${pageContext.request.contextPath}/ReportApproval?id=${report.reportId}"><div><strong><c:out value="${report.title}"/></strong><span><c:out value="${report.authorName}"/> ・ ${report.reportDate}</span></div><span class="status ${report.status}">${report.statusLabel}</span></a></c:forEach><c:if test="${empty reports}"><p class="empty">報告書はありません。</p></c:if></section>
<section class="report-editor"><c:choose><c:when test="${empty selectedReport}"><div class="select-guide">左の一覧から報告書を選択してください。</div></c:when><c:otherwise><div class="report-readonly"><div class="meta"><span><c:out value="${selectedReport.authorName}"/> ・ ${selectedReport.reportDate}</span><span class="status ${selectedReport.status}">${selectedReport.statusLabel}</span></div><h2><c:out value="${selectedReport.title}"/></h2><div class="report-body"><c:out value="${selectedReport.body}"/></div><c:choose><c:when test="${selectedReport.status == 'SUBMITTED'}"><form class="approval-form" method="post" action="${pageContext.request.contextPath}/ReportApproval"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="reportId" value="${selectedReport.reportId}"><label>承認者コメント<textarea name="comment" maxlength="1000" rows="5" placeholder="差戻しの場合は理由を必ず入力してください。"></textarea></label><div class="inline-actions"><button class="submit" type="submit" name="decision" value="APPROVED">承認する</button><button class="danger" type="submit" name="decision" value="REJECTED">差し戻す</button></div></form></c:when><c:otherwise><div class="review-comment"><strong>処理結果</strong><p><c:out value="${selectedReport.reviewComment}"/></p><small><c:out value="${selectedReport.reviewerName}"/> ・ ${selectedReport.reviewedAtLabel}</small></div></c:otherwise></c:choose></div></c:otherwise></c:choose></section></div></main></body></html>
